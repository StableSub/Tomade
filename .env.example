DART_OPENAPI_KEY=
TAVILY_API_KEY=
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# openai 또는 openrouter. 미지정 시 사용 가능한 키로 자동 선택
LLM_PROVIDER=openai

# 역할별 모델. 미지정하면 LLM_MODEL을 공통 fallback으로 사용
# PARSER_MODEL이 비어 있으면 WORKER_MODEL을 먼저 fallback으로 사용
PARSER_MODEL=
PLANNER_MODEL=
WORKER_MODEL=
REVIEWER_MODEL=
# 단기 요약 전용. 비워두면 gpt-5.6-luna (OpenRouter: openai/gpt-5.6-luna)
SUMMARY_MODEL=
LLM_MODEL=gpt-4o-mini

OPENAI_API_KEY=
OPENROUTER_API_KEY=
