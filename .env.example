DART_OPENAPI_KEY=
TAVILY_API_KEY=
# YouTube Data API 영상·댓글 수집 (Sentiment)
YOUTUBE_API_KEY=
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# openai / openrouter: API Key, openai_codex: ChatGPT 구독 OAuth
# 구독은 명시적으로 선택. 미지정 시 기존 API Key 공급자만 자동 선택
LLM_PROVIDER=openai

# 역할별 모델. 미지정하면 LLM_MODEL을 공통 fallback으로 사용
# PARSER_MODEL이 비어 있으면 WORKER_MODEL을 먼저 fallback으로 사용
PARSER_MODEL=
PLANNER_MODEL=
WORKER_MODEL=
# 단기 요약 전용. 비워두면 gpt-5.6-luna (OpenRouter: openai/gpt-5.6-luna)
SUMMARY_MODEL=
LLM_MODEL=gpt-4o-mini

# 구독 설정 창에서 역할별 모델과 아래 추론 깊이를 저장할 수 있음
# 빈 값: 공급자 기본값. low / medium / high / xhigh / max
# GPT-5.6 계열은 none도 지원, GPT-6 Astra는 none 미지원
# API Key 방식에는 아래 추론 설정을 전달하지 않음
CODEX_PLANNER_REASONING_EFFORT=
CODEX_PARSER_REASONING_EFFORT=
CODEX_WORKER_REASONING_EFFORT=
CODEX_SUMMARY_REASONING_EFFORT=
# REVIEWER_MODEL은 현재 호출하는 Agent가 없어 생략

# 구독 사용 시 LLM_PROVIDER=openai_codex, LLM_MODEL=gpt-5.6-luna로 변경
# 역할별 모델을 지정했다면 해당 ID도 구독 계정의 사용 가능한 모델로 변경
# 로그인: .venv/bin/python -m stock_agent.gateways.codex_auth login
# CODEX_AUTH_PATH=  # 미지정 시 ~/.config/stock-agent/codex-auth.json

# 공시 RAG 임베딩에도 사용. Codex 모델 구독과 별도 API 비용
OPENAI_API_KEY=
OPENROUTER_API_KEY=
